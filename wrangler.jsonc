{
  // One Cloudflare Worker serves both:
  //   /api/*  -> the CrossPOV server (server/src/index.ts)
  //   others  -> the demo website (the app's UI built into ./dist)
  // Cloudflare builds this on every push: `npm run build` then `npx wrangler deploy`.
  // Secrets (set in the dashboard as type Secret, never in this file):
  //   HENRIK_API_KEY, TWITCH_CLIENT_ID, TWITCH_CLIENT_SECRET
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crosspov",
  "main": "server/src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Never delete variables set in the Cloudflare dashboard on deploy.
  "keep_vars": true
}
