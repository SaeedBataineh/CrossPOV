{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrossPOV",
  "version": "0.1.8",
  "identifier": "app.crosspov.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CrossPOV",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "CrossPOV",
    "shortDescription": "Hotkey clips plus automatic streamer POV clips",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNEZCNjNFNDczMEYzOTAKUldTUTh6QkhQclpQa0twTFI0N3N2VFIrZkpjSk41dmdZNnhwR0lvcEw5UU45TkVqUDI5MFFVRUIK",
      "endpoints": [
        "https://github.com/SaeedBataineh/CrossPOV/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
